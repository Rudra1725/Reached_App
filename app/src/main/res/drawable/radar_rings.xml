<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0D131D" />
            <stroke android:width="1dp" android:color="#1A2A3A" />
        </shape>
    </item>
    <!-- Middle ring -->
    <item android:bottom="35dp" android:left="35dp" android:right="35dp" android:top="35dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#152230" />
        </shape>
    </item>
    <!-- Inner faint ring -->
    <item android:bottom="70dp" android:left="70dp" android:right="70dp" android:top="70dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#182C38" />
        </shape>
    </item>
</layer-list>